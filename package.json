{
  "name": "management-command-center",
  "version": "16.0.0",
  "private": true,
  "scripts": {
    "preinstall": "bash scripts/preinstall.sh",
    "dev": "bash scripts/start-dev.sh",
    "dev:raw": "NODE_ENV=development NEXT_DIST_DIR=.next-dev next dev -p 5000",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' prisma generate && NEXT_DIST_DIR=.next next build",
    "postbuild": "prisma db seed || echo 'Seed completed or skipped'",
    "start": "NODE_ENV=production NEXT_DIST_DIR=.next next start -H 0.0.0.0 -p ${PORT:-5000}",
    "start:production": "bash scripts/start-production.sh",
    "worker": "npx tsx worker/sync-worker.ts",
    "worker:dev": "NODE_ENV=development npx tsx worker/sync-worker.ts",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@auth/core": "^0.34.2",
    "@auth/prisma-adapter": "^2.11.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@getbrevo/brevo": "^3.0.1",
    "@google-cloud/storage": "^7.17.2",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^6.17.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@types/node": "^24.7.1",
    "@types/react": "^18.3.26",
    "@types/ws": "^8.18.1",
    "@uppy/aws-s3": "^4.3.2",
    "@uppy/core": "^4.5.3",
    "@uppy/dashboard": "^4.4.3",
    "@uppy/drag-drop": "^4.2.2",
    "@uppy/file-input": "^4.2.2",
    "@uppy/progress-bar": "^4.3.2",
    "@uppy/react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^0.7.2",
    "date-fns-tz": "^3.2.0",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "google-auth-library": "^10.4.0",
    "googleapis": "^161.0.0",
    "lucide-react": "^0.539.0",
    "next": "^14.2.33",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "openai": "^5.23.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.64.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prisma": "^6.17.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
